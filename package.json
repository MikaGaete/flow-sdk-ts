{
  "name": "flow-sdk-v2",
  "version": "2.2.1",
  "description": "SDK de TypeScript (no oficial) para la API de pagos de Flow (flow.cl): pagos, suscripciones, reembolsos, cupones y liquidaciones.",
  "keywords": [
    "flow",
    "flow.cl",
    "flowcl",
    "pagos",
    "payments",
    "chile",
    "chilean",
    "pasarela-de-pagos",
    "payment-gateway",
    "sdk",
    "typescript",
    "api",
    "suscripciones",
    "subscriptions",
    "ecommerce",
    "fintech"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MikaGaete/flow-sdk-ts.git"
  },
  "bugs": {
    "url": "https://github.com/MikaGaete/flow-sdk-ts/issues"
  },
  "homepage": "https://github.com/MikaGaete/flow-sdk-ts#readme",
  "scripts": {
    "test": "jest",
    "lint": "tsc",
    "build": "tsup",
    "prepublishOnly": "yarn build",
    "release": "changeset publish"
  },
  "author": "Mikael Gaete López",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "zod": "^3.22.4"
  }
}
